{
  "expo": {
    "name": "Mis Tareas",
    "slug": "todo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cristian.todoapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Mis Tareas necesita acceder a tus fotos para adjuntarlas a las tareas.",
          "cameraPermission": "Mis Tareas necesita la cámara para sacar fotos para tus tareas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mis Tareas usa tu ubicación para asociarla a las tareas."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Mis Tareas accede a tus contactos para asignar un responsable a cada tarea."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Mis Tareas agrega eventos a tu calendario para tus tareas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c1ac80e0-63f7-4650-ab6e-0cc7be7eafe0"
      }
    }
  }
}
